# Copy to .env and fill in real values. NEVER commit the real .env.
PORT=3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Service key bypasses Row-Level Security — keep it secret, server-only.
SUPABASE_SERVICE_KEY=your-service-key

# Auth — use long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret
# Separate secret for refresh tokens (falls back to JWT_SECRET if unset)
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Token lifetimes
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=30d

# OCR helpers
POPPLER_PATH=/usr/bin
PYTHON_PATH=python3

# Production: comma-separated allowed origins for CORS
# e.g. https://archiquant.in,https://impacgodeveloper.github.io
CORS_ORIGIN=

# Observability
LOG_LEVEL=info
# Error tracking — leave blank to disable Sentry
SENTRY_DSN=
