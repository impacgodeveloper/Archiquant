# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Backend (Node) ──────────────────────────────────────────
# Secrets — NEVER commit. Use .env on the server / .env.example in git.
**/.env
**/.env.*
!**/.env.example
# Dependencies & virtualenvs (reinstall with npm install / pip install)
**/node_modules/
backend/venv/
**/__pycache__/
# Uploaded plans / generated artifacts
backend/uploads/
*.pem
*.key

# Internal security assessments — keep out of the public repo
/PRODUCTION_AUDIT_*.md
